name: basic_cleaning

conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Input artifact to be cleaned
        type: string

      output_artifact:
        description: Output artifact for cleaned data
        type: string

      output_type:
        description: Type of the output dataset
        type: string

      output_description:
        description: Description of the cleaned dataset
        type: string

      min_price:
        description: Minimum nightly rental price
        type: float

      max_price:
        description: Maximum nightly rental price
        type: float

    command: >-
      python run.py
      --input_artifact {input_artifact}
      --output_artifact {output_artifact}
      --output_type {output_type}
      --output_description {output_description}
      --min_price {min_price}
      --max_price {max_price}
