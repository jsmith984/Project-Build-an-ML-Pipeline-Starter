name: basic_cleaning

conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Input raw CSV artifact
        type: str

      output_artifact:
        description: Name of cleaned output artifact
        type: str

      output_type:
        description: Type of cleaned output artifact
        type: str

      output_description:
        description: Description of cleaned output artifact
        type: str

      min_price:
        description: Minimum accepted price
        type: float
        default: 10

      max_price:
        description: Maximum accepted price
        type: float
        default: 350

    command: >-
      python run.py
      --input_artifact {input_artifact}
      --output_artifact {output_artifact}
      --output_type {output_type}
      --output_description "{output_description}"
      --min_price {min_price}
      --max_price {max_price}
