name: data_check

entry_points:
  main:
    parameters:
      csv:
        description: Input CSV artifact to test
        type: str
      ref:
        description: Reference CSV artifact
        type: str
      kl_threshold:
        description: KL divergence threshold
        type: float
        default: 0.2
      min_price:
        description: Minimum accepted price
        type: float
        default: 10
      max_price:
        description: Maximum accepted price
        type: float
        default: 350

    command: "pytest -vv -s test_data.py --csv {csv} --ref {ref} --kl_threshold {kl_threshold} --min_price {min_price} --max_price {max_price}"
